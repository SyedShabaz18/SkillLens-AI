# Optional for local use. If omitted, a random session key is generated each run,
# which signs users out after restart. Set a long random value for stable sessions.
# SKILLLENS_SECRET_KEY=replace-with-a-long-random-secret
# Optional custom database location
# SKILLLENS_DB=C:\\private-data\\skilllens.db
# Set to 1 only when served over HTTPS
SKILLLENS_HTTPS_ONLY=0
